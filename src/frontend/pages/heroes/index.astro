---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { GuestCard } from "@/components/GuestCard";
import { siteConfig } from "@/lib/config";

// Fetch guests from API
const response = await fetch(new URL('/api/guests', Astro.url.origin));
const data = await response.json();
const guests = data.guests || [];
---

<BaseLayout
  title="Heroes of Social Justice & AI | Renegade Capital"
  description="Explore visionary guests at the intersection of AI, finance, and social justice"
>
  <div class="container mx-auto px-4 py-12">
    <div class="mb-12">
      <h1 class="text-4xl font-bold tracking-tight text-foreground sm:text-5xl">
        Heroes of Social Justice & AI
      </h1>
      <p class="mt-4 text-lg text-muted-foreground max-w-3xl">
        Meet the visionaries, scholars, and practitioners reshaping the future at the intersection of finance, technology, and equity.
      </p>
      <div class="mt-6">
        <a
          href="/heroes/matchups"
          class="inline-flex h-11 items-center justify-center rounded-lg border border-border bg-background px-6 text-sm font-semibold text-foreground shadow-sm transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
        >
          View Episode Matchups
        </a>
      </div>
    </div>

    <!-- 3x3 Scrollable Grid -->
    <div class="grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-3">
      {guests.map((guest: any) => (
        <div
          key={guest.id}
          class="guest-card-wrapper"
          data-guest-id={guest.id}
        >
          <GuestCard
            name={guest.name}
            personaDescription={guest.personaDescription}
            domain={guest.domain}
            chemistry={guest.chemistry}
            headshotUrl={guest.headshotUrl}
            affiliation={guest.affiliation}
            client:load
          />
        </div>
      ))}
    </div>
  </div>

  <!-- Client-side Dialog Script -->
  <script>
    import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogDescription, DialogClose } from '@/components/ui/dialog';
    import { createRoot } from 'react-dom/client';
    import * as React from 'react';

    // Global state for dialog
    let dialogRoot: any = null;
    let dialogContainer: HTMLElement | null = null;

    function showInsightDialog(guestId: number) {
      // Create dialog container if it doesn't exist
      if (!dialogContainer) {
        dialogContainer = document.createElement('div');
        dialogContainer.id = 'insight-dialog-root';
        document.body.appendChild(dialogContainer);
        dialogRoot = createRoot(dialogContainer);
      }

      // Fetch insight
      fetch(`/api/ai/insights/${guestId}`)
        .then(res => res.json())
        .then(data => {
          const guest = data.guest;
          const insight = data.insight;

          // Render Dialog
          dialogRoot.render(
            React.createElement(Dialog, {
              defaultOpen: true,
              onOpenChange: (open: boolean) => {
                if (!open && dialogRoot) {
                  dialogRoot.unmount();
                  if (dialogContainer) {
                    document.body.removeChild(dialogContainer);
                    dialogContainer = null;
                    dialogRoot = null;
                  }
                }
              }
            },
              React.createElement(DialogContent, { className: 'max-w-2xl' },
                React.createElement(DialogHeader, {},
                  React.createElement(DialogTitle, {}, guest.name),
                  React.createElement(DialogDescription, {}, guest.affiliation)
                ),
                React.createElement('div', { className: 'mt-4 space-y-4' },
                  React.createElement('div', { className: 'flex items-start gap-4' },
                    guest.headshotUrl && React.createElement('img', {
                      src: guest.headshotUrl,
                      alt: guest.name,
                      className: 'h-20 w-20 rounded-full object-cover ring-2 ring-primary/20'
                    }),
                    React.createElement('div', { className: 'flex-1' },
                      React.createElement('h3', { className: 'text-sm font-semibold text-foreground mb-2' }, 'Why they\'d be a great guest:'),
                      React.createElement('p', { className: 'text-sm leading-relaxed text-muted-foreground' }, insight)
                    )
                  ),
                  React.createElement('div', { className: 'border-t border-border pt-4' },
                    React.createElement('p', { className: 'text-xs text-muted-foreground italic' }, guest.personaDescription)
                  )
                )
              )
            )
          );
        })
        .catch(error => {
          console.error('Failed to fetch insight:', error);
          alert('Failed to load guest insight. Please try again.');
        });
    }

    // Add click handlers to guest cards
    document.addEventListener('DOMContentLoaded', () => {
      const cardWrappers = document.querySelectorAll('.guest-card-wrapper');

      cardWrappers.forEach(wrapper => {
        const card = wrapper.querySelector('[data-slot="card"]');
        const guestId = wrapper.getAttribute('data-guest-id');

        if (card && guestId) {
          card.addEventListener('click', () => {
            showInsightDialog(parseInt(guestId));
          });

          // Add cursor pointer
          (card as HTMLElement).style.cursor = 'pointer';
        }
      });
    });
  </script>
</BaseLayout>
