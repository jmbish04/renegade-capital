---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { GuestList } from "@/components/GuestList";
import { Users } from "lucide-react";
---

<BaseLayout
  title="AI Hero Gallery | Renegade Capital"
  description="Meet the visionaries reshaping the future of finance, technology, and equity."
>
  <main class="flex-1 bg-zinc-950 px-6 py-12 md:px-12">
    <div class="max-w-7xl mx-auto mb-16">
       <div class="flex flex-col md:flex-row items-end justify-between gap-8">
          <div class="max-w-xl">
            <h2 class="text-xs font-black uppercase tracking-[0.3em] text-purple-600 mb-4 flex items-center gap-2">
              <Users className="size-3 fill-purple-600" /> Human Intelligence
            </h2>
            <h3 class="text-3xl md:text-6xl font-bold text-white tracking-tight leading-none uppercase italic">
              Hero Gallery
            </h3>
          </div>
          <div class="flex flex-col items-end gap-4">
            <p class="text-zinc-500 max-w-sm text-sm text-right">
              The visionaries, scholars, and practitioners whose expertise powers the Renegade RAG engine.
            </p>
            <a
              href="/heroes/matchups"
              class="inline-flex h-11 items-center justify-center rounded-lg border border-zinc-800 bg-zinc-900 px-6 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-zinc-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-purple-600"
            >
              View Episode Matchups
            </a>
          </div>
       </div>
    </div>

    <div class="max-w-7xl mx-auto">
      <GuestList client:load />
    </div>
  </main>
</BaseLayout>
