{
  "name": "cloudflare-edge-service",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "start": "astro dev",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "check": "oxlint && oxfmt",
    "db:generate": "drizzle-kit generate && node -e \"const fs=require('fs');const p='./drizzle';fs.readdirSync(p).filter(f=>f.endsWith('.sql')).forEach(f=>{const fP=p+'/'+f;fs.writeFileSync(fP,fs.readFileSync(fP,'utf8').replace(/CREATE TABLE (?!IF NOT EXISTS)/g,'CREATE TABLE IF NOT EXISTS '));})\"",
    "migrate:local": "pnpm run db:generate && npx wrangler d1 migrations apply DB --local",
    "migrate:remote": "pnpm run db:generate && npx wrangler d1 migrations apply DB --remote",
    "deploy": "pnpm run build && npx tsx scripts/deploy-db.ts && npx wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.60",
    "@ai-sdk/react": "^3.0.170",
    "@assistant-ui/react": "^0.12.26",
    "@assistant-ui/react-ai-sdk": "^1.3.20",
    "@astrojs/cloudflare": "^13.2.1",
    "@astrojs/react": "^5.0.4",
    "@base-ui/react": "^1.4.1",
    "@cloudflare/agents": "^0.0.16",
    "@cloudflare/ai-chat": "^0.6.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.3.0",
    "@hono/zod-validator": "^0.7.6",
    "@openai/agents": "^0.9.1",
    "@openai/agents-extensions": "^0.9.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@scalar/hono-api-reference": "^0.10.10",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-table": "^8.21.3",
    "@udecode/plate-basic-elements": "^49.0.0",
    "@udecode/plate-basic-marks": "^49.0.0",
    "@udecode/plate-common": "^42.0.0",
    "@udecode/plate-core": "^49.0.0",
    "agents": "^0.12.3",
    "ai": "^6.0.168",
    "ai-sdk": "link:@openai/agents-extensions/ai-sdk",
    "astro": "^6.1.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.38.0",
    "hono": "^4.12.15",
    "lucide-react": "^1.11.0",
    "next-themes": "^0.4.6",
    "openai": "^6.36.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "recharts": "3.8.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "shadcn": "^4.5.0",
