{
  "name": "renegade-capital",
  "main": "src/_worker.ts",
  "compatibility_date": "2026-05-04",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": true,
    "not_found_handling": "none",
  },
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "vars": {
    "AI_GATEWAY_ID": "default-gateway",
    "AI_MODEL_CHAT": "@cf/openai/gpt-oss-120b",
    "AI_MODEL_EMBEDDINGS": "@cf/baai/bge-large-en-v1.5",
    "AI_MODEL_RERANKING": "@cf/baai/bge-reranker-base",
    "INTRO_VIDEO_URL": "https://renegade-capital-files.hacolby.app/media/IntroPodcastExplainer.mp4",
    "CLOUDFLARE_IMAGES_BASE_URL": "https://renegade-capital-fuck-trump.126colby.workers.dev/",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "renegade-capital",
      "database_id": "70b7b632-98af-4635-a9d0-271f02a63ef3",
      "migrations_dir": "drizzle",
      "remote": true,
    },
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "70e70f5ca7f145efb801060b237acfbe",
      "remote": true
    },
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "renegade-capital-trump-policy-pages",
      "remote": true
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2_TRUMP_POLICY",
      "bucket_name": "renegade-capital-fuck-trump",
      "remote": true,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "POLICY_AGENT",
        "class_name": "PolicyAgent"
      },
      {
        "name": "PODCAST_AGENT",
        "class_name": "PodcastAgent"
      },
      {
        "name": "INVESTOR_AGENT",
        "class_name": "InvestorAgent"
      },            
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PolicyAgent",
        "PodcastAgent",
        "InvestorAgent",
      ]
    }
  ],
  "triggers": {
    "crons": [
      // 5 PM UTC every Sunday
      "0 17 * * sun"
    ] 
  },
  "secrets_store_secrets": [
    {
      "binding": "GITHUB_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "GH_TOKEN",
    },
    {
      "binding": "CLOUDFLARE_ACCOUNT_ID",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_ACCOUNT_ID",
    },
    {
      "binding": "CLOUDFLARE_WRANGLER_API_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_WRANGLER_API_TOKEN",
    },
    {
      "binding": "CLOUDFLARE_AI_GATEWAY_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_AI_GATEWAY_TOKEN",
    },
    {
      "binding": "CLOUDFLARE_WORKER_ADMIN_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_WORKER_ADMIN_TOKEN",
    },
    {
      "binding": "CLOUDFLARE_AI_SEARCH_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_AI_SEARCH_TOKEN",
    },
    {
      "binding": "CLOUDFLARE_OBSERVABILITY_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_OBSERVABILITY_TOKEN",
    },
    {
      "binding": "JULES_API_KEY",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "JULES_API_KEY",
    },
    {
      "binding": "CLOUDFLARE_IMAGES_STREAM_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_IMAGES_STREAM_TOKEN",
    },
    {
      "binding": "WORKER_API_KEY",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "WORKER_API_KEY",
    },
    {
      "binding": "AGENTIC_WORKER_API_KEY",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "AGENTIC_WORKER_API_KEY",
    },
    {
      "binding": "CF_BROWSER_RENDER_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_BROWSER_RENDER_TOKEN",
    },

  ],
}
