{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": ".",
    "ignoreDeprecations": "5.0",
    "types": [
      "@cloudflare/workers-types",
      "./worker-configuration.d.ts"
    ],
    "paths": {
      "@/*": [ "src/frontend/*", "src/backend/*" ],
      "@/backend/*": [ "src/backend/*" ]
    }
  },
  "include": [ ".astro/types.d.ts", "src/**/*", "worker-configuration.d.ts", "scripts/**/*" ]
}